<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gripper">

  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="baud_rate" default="1000000"/>
  <xacro:arg name="timeout" default="1000"/>
  <xacro:arg name="slave_address" default="1"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="position_mode_speed_register" default="1000"/>
  <xacro:arg name="target_force_percent" default="50"/>
  <xacro:arg name="gripper_closed_position" default="0.1"/>
  <xacro:arg name="gripper_model" default="TG-9801"/>

  <!-- Promote arg to property to avoid undefined errors in expressions -->
  <xacro:property name="gripper_closed_position" value="$(arg gripper_closed_position)"/>
  <xacro:property name="gripper_half_travel" value="${gripper_closed_position / 2.0}"/>

    <material name="metal">
      <color rgba=".58 .58 .58 1"/>
    </material>
    <material name="silicone">
      <color rgba=".1882 .1882 .1882 1"/>
    </material>
    <material name="black_gripper">
      <color rgba=".149 .149 .149 1"/>
    </material>

    <!-- 主体 -->
    <link name="gripper_base_link">
      <visual>
        <origin xyz="0 0 .0615" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ros2_hkv_gripper/meshes/base_body.stl" scale=".001 .001 .001"/>
        </geometry>
        <material name="silicone"/>
      </visual>
    </link>

    <!-- 导轨 -->
    <link name="rail_155">
      <visual>
        <origin xyz="0 0 .067" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ros2_hkv_gripper/meshes/rail_155.stl" scale=".001 .001 .001"/>
        </geometry>
        <material name="metal"/>
      </visual>
    </link>

    <joint name="base_2_rail" type="fixed">
      <parent link="gripper_base_link"/>
      <child link="rail_155"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- 滑块 -->
    <link name="slider_r">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ros2_hkv_gripper/meshes/slider.stl" scale=".001 .001 .001"/>
        </geometry>
        <material name="metal"/>
      </visual>
    </link>

    <link name="slider_l">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ros2_hkv_gripper/meshes/slider.stl" scale=".001 .001 .001"/>
        </geometry>
        <material name="metal"/>
      </visual>
    </link>

    <!-- 夹指 -->
    <link name="finger_r">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ros2_hkv_gripper/meshes/finger.stl" scale=".001 .001 .001"/>
        </geometry>
        <material name="silicone"/>
      </visual>
    </link>

    <link name="finger_l">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ros2_hkv_gripper/meshes/finger.stl" scale=".001 .001 .001"/>
        </geometry>
        <material name="silicone"/>
      </visual>
    </link>

    <link name="gripper_gap_link"/>

    <!-- 虚拟关节：对外发布的 gripper_joint 表示两指间距 (0~gripper_closed_position) -->
    <joint name="gripper_joint" type="prismatic">
      <parent link="rail_155"/>
      <child link="gripper_gap_link"/>
      <origin xyz="0 0 .067" rpy="0 0 0"/>
      <limit effort="1000.0" lower="0" upper="${gripper_closed_position}" velocity="0.5"/>
      <axis xyz="1 0 0"/>
    </joint>

    <!-- 左右滑块跟随 gripper_joint，各自移动一半行程，方向相反 -->
    <joint name="rail_2_slider_l" type="prismatic">
      <parent link="rail_155"/>
      <child link="slider_l"/>
      <origin xyz="-0.06545 0 .067" rpy="0 0 0"/>
      <limit effort="1000.0" lower="0" upper="${gripper_half_travel}" velocity="0.5"/>
      <axis xyz="1 0 0"/>
      <mimic joint="gripper_joint" multiplier="0.5" offset="0.0"/>
    </joint>

    <joint name="rail_2_slider_r" type="prismatic">
      <parent link="rail_155"/>
      <child link="slider_r"/>
      <origin xyz=".06545 0 .067" rpy="0 0 0"/>
      <limit effort="1000.0" lower="-${gripper_half_travel}" upper="0" velocity="0.5"/>
      <axis xyz="1 0 0"/>
      <mimic joint="gripper_joint" multiplier="-0.5" offset="0.0"/>
    </joint>

    <joint name="slider_2_finger_r" type="fixed">
      <parent link="slider_r"/>
      <child link="finger_r"/>
      <origin xyz="0 0 .008" rpy="0 0 3.1415927"/>
    </joint>

    <joint name="slider_2_finger_l" type="fixed">
      <parent link="slider_l"/>
      <child link="finger_l"/>
      <origin xyz="0 0 .008" rpy="0 0 0"/>
    </joint>

  <!-- ROS2 Control -->
  <ros2_control name="tg9801_ros2_control" type="system">
    <hardware>
      <xacro:if value="$(arg use_fake_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
        <param name="fake_sensor_commands">false</param>
        <param name="state_following_offset">0.0</param>
      </xacro:if>
      <xacro:unless value="$(arg use_fake_hardware)">
        <plugin>ros2_hkv_gripper/GripperHardwareInterface</plugin>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">$(arg baud_rate)</param>
        <param name="timeout">$(arg timeout)</param>
        <param name="slave_address">$(arg slave_address)</param>
        <param name="gripper_model">$(arg gripper_model)</param>
        <!-- 夹爪闭合行程（米），对外统一用 SI 单位 -->
        <param name="gripper_closed_position">$(arg gripper_closed_position)</param>
        <param name="position_open_register">1000</param>
        <param name="position_closed_register">0</param>
        <param name="position_mode_speed_register">$(arg position_mode_speed_register)</param>
        <param name="target_force_percent">$(arg target_force_percent)</param>
      </xacro:unless>
    </hardware>
    
    <joint name="gripper_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
